# Deployment environment. "production" disables /docs, /redoc, /openapi.json
# and refuses to start with default JWT secrets. Leave as "development" locally.
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Database
# Port 5442, not 5432 — a native PostgreSQL service already owns 5432 on
# machines where one is installed; the docker-compose Postgres is mapped to
# 5442 to avoid silently colliding with it.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5442/srm_approval

# JWT secrets (generate real random values — openssl rand -hex 64 — required
# in production; startup fails if these are left at their defaults and
# ENVIRONMENT=production)
ACCESS_TOKEN_SECRET=change-me-access
REFRESH_TOKEN_SECRET=change-me-refresh
RESET_TOKEN_SECRET=

# Cookies (leave false in production; true only for local http dev)
ALLOW_INSECURE_COOKIES=false

# Reverse-proxy trust (leave empty locally; in production set to the
# addresses nginx connects from — e.g. ["127.0.0.1"] if nginx runs on the
# same host as this app — so X-Forwarded-For/-Proto are honored)
TRUSTED_PROXY_IPS=[]

# CORS. In production this must list the real nginx-served frontend
# origin(s), e.g. ["https://srm.yourcompany.internal"]
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Email
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Self-signup
SELF_SIGNUP_ROLES=["REQUESTER"]

# File storage
STORAGE_ROOT=./storage

# SOP search
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where the AI model is kept. Leave empty to use <STORAGE_ROOT>/ai-models (recommended).
EMBEDDING_CACHE_DIR=
SOP_MATCH_THRESHOLD=0.45
