# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment
#
# The default setup needs NO variables at all. The app calls its own origin
# under /api, and a proxy forwards that to the backend:
#
#   development → server.proxy in vite.config.js
#   production  → the `location /api/` block in deploy/nginx/
#
# That is what keeps the build portable (no backend hostname is compiled into
# dist/) and what keeps the `jwt` refresh cookie first-party.
# ─────────────────────────────────────────────────────────────────────────────

# Where `vite dev` forwards /api to. Dev only — it is read by vite.config.js,
# never by the browser, and is not part of the production build.
# Defaults to http://localhost:5000.
API_PROXY_TARGET=http://localhost:5000


# ─── Escape hatch: do not set this for the standard deployment ───────────────
#
# VITE_API_URL overrides the `/api` same-origin default and points the app
# directly at a backend on another origin. Setting it means you must also:
#
#   1. add this app's origin to the API's CORS allowlist
#      (backend/src/config/allowedOrigins.js), and
#   2. accept that the refresh cookie becomes cross-site — it is SameSite=Lax,
#      so it will NOT be sent, and users will be logged out on every reload
#      unless the backend is changed to SameSite=None; Secure.
#
# Note that /api/auth/* stays same-origin regardless, precisely because of (2).
#
# If you have a local .env left over from an earlier setup, delete the
# VITE_API_URL line from it — otherwise it silently overrides the default above.
#
# VITE_API_URL=https://api.example.internal
